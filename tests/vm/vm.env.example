# Test VM settings for tests/vm (not secret, local to this machine)
VM_IP=192.168.100.33
VM_PREFIX=24
VM_GW=192.168.100.1
VM_DNS=192.168.100.1
VM_DOMAIN=example.lan
VM_HOSTNAME=zfs-testvm
# Subnet scanned for dropbear (ZBM gets its own DHCP lease)
VM_SCAN_NET=192.168.100
# Name in the Proxmox node certificate (the API IP is not in its SAN)
PVE_CERT_NAME=pve.example.lan
# Throwaway passphrase, must match the inventory
TEST_PASSPHRASE=zfs-test-Passphrase1
VM_ISO=local:iso/zfs-test-live.iso
