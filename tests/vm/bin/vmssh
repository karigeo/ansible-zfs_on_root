#!/bin/bash
# SSH to the test VM with the test key.
# Usage: vmssh [-p 222] [user@host] [command...]   (default ansible@$VM_IP)
#        dropbear: vmssh -p 222 root@<ip> unlock-luks
. "$(dirname "$0")/common.sh"
port=22
if [ "${1:-}" = -p ]; then port=$2; shift 2; fi
target=${1:-ansible@$VM_IP}; shift || true
exec ssh "${SSH_OPTS[@]}" -p "$port" "$target" "$@"
