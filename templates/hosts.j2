{# Use the first static address of the new system's network config (bridges first),
   otherwise the address the live system currently uses #}
{% set static_ifaces = (ipv4.bridges | default([])) + (ipv4.interfaces | default([])) %}
{% set static_ifaces = static_ifaces | selectattr('address_type', 'equalto', 'static') | list %}
{% if static_ifaces | length > 0 %}
{%   set host_ip = static_ifaces[0].network_address.split('/')[0] %}
{% else %}
{%   set host_ip = ansible_facts['default_ipv4']['address'] %}
{% endif %}
127.0.0.1       localhost
{{ host_ip }}       {{ host_name }}.{{ domain_name }} {{ host_name }}
::1     localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
